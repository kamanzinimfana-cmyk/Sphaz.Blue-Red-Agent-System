{
  "manifest_version": 3,
  "name": "Blue Red Agent",
  "version": "1.0",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:3000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "content/floating-ui.js", "content/detector.js", "content/grid.js"],
      "css": ["content/floating-ui.css"]
    }
  ]
}
